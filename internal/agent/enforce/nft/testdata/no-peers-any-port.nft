table inet innerwall {}
delete table inet innerwall
table inet innerwall {
	set r_0191e5c0_0000_7000_8000_000000000001_tcp_v4 {
		type ipv4_addr
		flags interval
	}
	set r_0191e5c0_0000_7000_8000_000000000001_tcp_v6 {
		type ipv6_addr
		flags interval
	}
	chain inbound {
		type filter hook input priority filter + 10; policy accept;
		iif "lo" accept
		ct state established,related accept
		ip saddr @r_0191e5c0_0000_7000_8000_000000000001_tcp_v4 meta l4proto tcp ct mark set (ct mark & 0x0000ffff) | 0x00010000 accept comment "innerwall rule 0191e5c0-0000-7000-8000-000000000001/tcp mark 1"
		ip6 saddr @r_0191e5c0_0000_7000_8000_000000000001_tcp_v6 meta l4proto tcp ct mark set (ct mark & 0x0000ffff) | 0x00010000 accept comment "innerwall rule 0191e5c0-0000-7000-8000-000000000001/tcp mark 1"
		log prefix "innerwall " group 200 drop comment "innerwall terminal enforced"
	}
}

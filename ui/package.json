{
	"name": "innerwall-console",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Innerwall operator console: a static single-page application embedded into the control-plane binary and served by the operator listener.",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/generate-api.mjs && tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "biome ci .",
		"check": "biome check --write .",
		"generate:api": "node scripts/generate-api.mjs"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.1",
		"@fontsource/ibm-plex-mono": "^5.2.0",
		"@fontsource/ibm-plex-sans": "^5.2.0",
		"@radix-ui/react-dialog": "^1.1.0",
		"@radix-ui/react-popover": "^1.1.0",
		"@radix-ui/react-slot": "^1.2.0",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router": "^7.9.0",
		"tailwind-merge": "^3.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"happy-dom": "^20.14.5",
		"openapi-typescript": "^7.9.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.9.0",
		"vite": "^7.1.0",
		"vitest": "^3.2.0"
	}
}
